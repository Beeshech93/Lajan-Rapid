# ==============================================================================
# LAJAN RAPID / WHITE LABEL MULTI-EMPRESA — ARCHIVO DE VARIABLES DE ENTORNO
# ==============================================================================
# Copia este archivo a `.env` y completa tus credenciales.
#
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (Base de Datos, Autenticación, RLS y Storage de Imágenes)
# ------------------------------------------------------------------------------
# Obtén estas claves en: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_PROJECT_ID=tu-proyecto-id
SUPABASE_PUBLISHABLE_KEY=tu-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=tu-supabase-service-role-key

# Mismos valores con prefijo VITE_ para acceso del cliente frontend
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_PROJECT_ID=tu-proyecto-id
VITE_SUPABASE_PUBLISHABLE_KEY=tu-supabase-anon-key

# ------------------------------------------------------------------------------
# 2. STRIPE (Cobros Internacionales con Tarjeta de Crédito/Débito) [OPCIONAL]
# ------------------------------------------------------------------------------
# Obtén estas claves en: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_tu_clave_secreta
STRIPE_PUBLISHABLE_KEY=pk_live_tu_clave_publica
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_tu_clave_publica
STRIPE_WEBHOOK_SECRET=whsec_tu_firma_webhook

# ------------------------------------------------------------------------------
# 3. MERCADO PAGO (Cobros México: SPEI, Tarjeta, OXXO) [OPCIONAL]
# ------------------------------------------------------------------------------
# Obtén estas claves en: https://www.mercadopago.com.mx/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=APP_USR-tu_access_token_de_produccion
MERCADOPAGO_PUBLIC_KEY=APP_USR-tu_public_key
VITE_MERCADOPAGO_PUBLIC_KEY=APP_USR-tu_public_key
MERCADOPAGO_WEBHOOK_SECRET=tu_firma_secreta_webhook

# ------------------------------------------------------------------------------
# 4. BAZIK API (Dispersión directa a MonCash y NatCash en Haití) [OPCIONAL]
# ------------------------------------------------------------------------------
# Obtén estas claves en tu panel de Bazik: https://bazik.io
BAZIK_API_KEY=bzk_live_tu_api_key
BAZIK_API_SECRET=tu_api_secret_bazik
BAZIK_API_ENDPOINT=https://api.bazik.io/v1

# ------------------------------------------------------------------------------
# 5. DINGCONNECT (Recargas Telefónicas Digicel & Natcom) [OPCIONAL]
# ------------------------------------------------------------------------------
# https://www.dingconnect.com
DINGCONNECT_API_KEY=tu_api_key_dingconnect

# ------------------------------------------------------------------------------
# 6. RESEND (Envío de Comprobantes y Notificaciones por Correo) [OPCIONAL]
# ------------------------------------------------------------------------------
# https://resend.com/api-keys
RESEND_API_KEY=re_tu_api_key_resend
